RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# PHP Settings for Uploads
php_value upload_max_filesize 256M
php_value post_max_size 256M
php_value memory_limit 512M
php_value max_execution_time 300

# Error Documents
ErrorDocument 404 /index.php?q=404
ErrorDocument 500 /index.php?q=404

# Cache-Control for static assets
<FilesMatch "\.(css|js|png|jpg|jpeg|gif|ico|woff|woff2|ttf|svg)$">
    Header set Cache-Control "max-age=86400, public"
</FilesMatch>

# Sitemap and Robots rewrites
RewriteRule ^sitemap\.xml$ pages/sitemap.php [L]
RewriteRule ^robots\.txt$ pages/robots.php [L]

# Main Routing
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ index.php?q=$1 [NC,L,QSA]